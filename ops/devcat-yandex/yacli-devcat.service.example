[Unit]
Description=DevCat Yandex Mail and Disk MCP (CatVPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/opt/yacli-devcat/current
Environment=YACLI_DEVCAT_MODE=1
Environment=YACLI_DEVCAT_ACCOUNT=devcat
Environment=YACLI_DEVCAT_CAPABILITIES=mail.read,mail.send,disk.read,disk.write
Environment=YACLI_DEVCAT_DISK_ROOTS=disk:/DevCat
Environment=YACLI_DEVCAT_MCP_TOKEN_VAULT_KEY=DEVCAT_YANDEX_MCP_BEARER
Environment=YACLI_DEVCAT_OAUTH_CLIENT_ID=7caac656017c4cac84c193cef1e02a34
Environment=YACLI_DEVCAT_OAUTH_MAIL_FULL=1
Environment=YACLI_DEVCAT_VAULT_HELPER=/usr/local/libexec/catvps-vault
Environment=YACLI_CONFIG_DIR=/var/lib/yacli-devcat/config
ExecStart=/opt/yacli-devcat/current/yacli mcp --transport http --listen 127.0.0.1:8787
Restart=on-failure
RestartSec=5
StateDirectory=yacli-devcat
RuntimeDirectory=yacli-devcat
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/yacli-devcat
NoNewPrivileges=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
